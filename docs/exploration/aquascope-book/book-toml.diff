 [preprocessor.aquascope]
+# Pin upstream's implicit (alphabetical) order: aquascope before quiz and
+# the trpl-* preprocessors (their cmark round-trip re-fences ```aquascope
+# blocks with four backticks, which mdbook-aquascope then mis-parses).
+before = ["quiz", "trpl-listing", "trpl-note"]
+command = "/path/to/aquascope/bin/mdbook-aquascope"
 
+# RustViz prototype: blocks opt in with fence flags (rustviz,
+# rustviz-default, rustviz-only); unflagged blocks are untouched. Must run
+# before aquascope (it wraps the raw ```aquascope fences, which aquascope
+# then replaces).
+[preprocessor.rustviz]
+command = "/path/to/rustviz/bin/mdbook-rustviz"
+before = ["aquascope"]
