# Loaded by Vite when invoked with `--mode pages` (i.e. `npm run build:pages`).
# Sets the API origin the SPA will hit when it's hosted on GitHub Pages
# rather than served same-origin by the playground binary: the Cloud Run
# service deployed by playground/cloudrun/deploy.sh. Keep in sync with the
# CORS allowlist in playground/src/main.rs.
VITE_API_BASE=https://rustviz-api-816769776225.us-central1.run.app
